    "sync": "node --env-file=${SYNC_ENV_FILE:-../class_OS/.env.local} --import tsx scripts/sync.ts",
    "review:bundle": "tsx scripts/review-bundle.ts",
    "review:assemble": "tsx scripts/review-assemble.ts",
