# Public Supabase settings. Leave both unset to run on the built-in fixtures (development only).
# Both values are safe to expose to the browser. After migration 0004 the publishable key can
# read nothing; it only drives the owner's magic-link sign-in and the homework RPCs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, scripts/screenshots.ts only. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Server-only. Reads all content in the app (lib/supabase/admin.ts, behind the owner check or a share
# token) and is used by scripts/sync.ts, pending.ts and status.ts. Set it in Vercel as a server-only
# variable. Never NEXT_PUBLIC, and never import it from components/ or a "use client" file.
SUPABASE_SECRET_KEY=

# Server-only. The one email address allowed to sign in. Everyone else gets no access.
OWNER_EMAIL=

# Local testing only (ignored in production): with Supabase unset, keep share links in memory.
# CLASSOS_DEV_MEMORY_SHARING=1

# Server-only. Read by scripts/homework-sync.ts (npm run homework:sync) and nothing else.
# The passcode that unlocks /homework/<slug>. Long and random (at least 16 characters; the
# RPC can be brute-forced, see supabase/migrations/0003_homework.sql). Only its bcrypt hash
# is stored in Supabase.
HOMEWORK_PASSCODE=
