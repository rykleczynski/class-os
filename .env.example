# Public Supabase settings. Leave both unset to run on the built-in fixtures.
# Both values are safe to expose to the browser (the publishable key is subject to RLS).
# Never put a service-role or secret key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, scripts/screenshots.ts only. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Server-only. Read by scripts/sync.ts (npm run sync) and nothing else.
# Never NEXT_PUBLIC, and never import it from app/ or components/.
SUPABASE_SECRET_KEY=

# Server-only. Read by scripts/homework-sync.ts (npm run homework:sync) and nothing else.
# The passcode that unlocks /homework/<slug>. Long and random (at least 16 characters; the
# RPC can be brute-forced, see supabase/migrations/0003_homework.sql). Only its bcrypt hash
# is stored in Supabase.
HOMEWORK_PASSCODE=
